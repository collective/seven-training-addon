{
  "name": "aurora-training-project-dev",
  "version": "1.0.0",
  "description": "Plone Aurora training project with a Python CMFPlone backend.",
  "author": "Victor Fernandez de Alba",
  "homepage": "https://github.com/collective/aurora-training-project",
  "license": "MIT",
  "keywords": [
    "volto-addon",
    "volto",
    "plone",
    "react"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "DATABASE_URL=\"file:$(pwd)/packages/aurora-training-project/prisma/dev.db\" REGISTRYCONFIG=$(pwd)/registry.config.ts pnpm --filter @plone/aurora dev",
    "start": "DATABASE_URL=\"file:$(pwd)/packages/aurora-training-project/prisma/dev.db\" REGISTRYCONFIG=$(pwd)/registry.config.ts pnpm --filter @plone/aurora dev",
    "start:prod": "DATABASE_URL=\"file:$(pwd)/packages/aurora-training-project/prisma/dev.db\" pnpm --filter @plone/aurora start:prod",
    "build": "REGISTRYCONFIG=$(pwd)/registry.config.ts pnpm --filter @plone/aurora build",
    "build:deps": "pnpm --filter @plone/registry --filter @plone/components build",
    "i18n": "pnpm --filter aurora-training-project i18n && VOLTOCONFIG=$(pwd)/volto.config.js pnpm --filter @plone/volto i18n",
    "test": "pnpm --filter aurora-training-project exec vitest --passWithNoTests",
    "lint": "REGISTRYCONFIG=$(pwd)/registry.config.ts eslint --max-warnings=0 'packages/**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "REGISTRYCONFIG=$(pwd)/registry.config.ts eslint --fix 'packages/**/*.{js,jsx,ts,tsx}'",
    "prettier": "prettier --check 'packages/**/*.{js,jsx,ts,tsx}'",
    "prettier:fix": "prettier --write 'packages/**/*.{js,jsx,ts,tsx}' ",
    "stylelint": "stylelint 'packages/**/*.{css,scss,less}' --allow-empty-input",
    "stylelint:fix": "stylelint 'packages/**/*.{css,scss,less}' --fix --allow-empty-input",
    "dry-release": "pnpm --filter aurora-training-project dry-release",
    "release": "pnpm --filter aurora-training-project release",
    "release-major-alpha": "pnpm --filter aurora-training-project release-major-alpha",
    "release-alpha": "pnpm --filter aurora-training-project release-alpha",
    "storybook": "VOLTOCONFIG=$(pwd)/volto.config.js pnpm --filter @plone/volto storybook dev -p 6006 -c $(pwd)/.storybook",
    "storybook-build": "VOLTOCONFIG=$(pwd)/volto.config.js pnpm --filter @plone/volto build-storybook -c $(pwd)/.storybook",
    "test:acceptance": "playwright test -c playwright-acceptance.config.ts",
    "test:acceptance:ui": "playwright test -c playwright-acceptance.config.ts --ui"
  },
  "dependencies": {
    "@plone/registry": "workspace:*",
    "@plone/aurora": "workspace:*",
    "aurora-training-project": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.60.0",
    "mrs-developer": "^2.2.0",
    "playwright": "^1.60.0"
  },
  "packageManager": "pnpm@11.20.0"
}
